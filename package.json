{
  "name": "database-management-app",
  "productName": "Faragon Database",
  "version": "0.2.0",
  "description": "Database management desktop app",
  "author": "JOHN",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/start-dev.mjs",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "security:migrate-admins": "node ./scripts/migrate-admins-to-supabase-auth.mjs",
    "security:verify-auth": "node ./scripts/verify-production-auth.mjs",
    "dist": "npm run build && cross-env NODE_ENV=production electron-builder",
    "dist:modern": "npm run dist",
    "dist:win7": "npm run build && cross-env NODE_ENV=production FARAGON_LEGACY_WINDOWS=1 electron-builder --config electron-builder.win7.cjs --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "2.112.2",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "exceljs": "4.4.0",
    "google-auth-library": "^10.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.0",
    "node-fetch": "2.7.0",
    "nodemailer": "9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "wait-on": "*"
  },
  "overrides": {
    "axios": "^1.19.0",
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@3.0.0 - 5.0.8": "5.0.9",
    "form-data": "^4.0.6",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "qs": "^6.11.0",
    "tar": "7.5.22",
    "tough-cookie": "^4.2.0",
    "uuid": "11.1.1"
  },
  "browserslist": {
    "production": [
      "chrome >= 108",
      "edge >= 108",
      "firefox >= 111",
      "safari >= 16.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 edge version"
    ]
  },
  "build": {
    "appId": "com.example.nextdesktop",
    "publish": {
      "provider": "github",
      "owner": "johntest811",
      "repo": "-Faragon-_DatabaseManagementSystem-"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "skills-lock.json",
        "to": "skills-lock.json"
      }
    ],
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json",
      "skills-lock.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/Logo.png",
      "artifactName": "Faragon.Database.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/Logo.ico",
      "uninstallerIcon": "public/Logo.ico",
      "installerHeaderIcon": "public/Logo.ico"
    }
  },
  "main": "electron/main.js"
}
